# ── Chain ─────────────────────────────────────────────────────────────────────
RPC_URL=https://forno.celo.org
CHAIN_ID=42220

# ── Coordinator wallet (used to call hireAgent / completeTask) ────────────────
COORDINATOR_PRIVATE_KEY=0x...

# ── Deployed contract addresses ───────────────────────────────────────────────
AGENT_REGISTRY_ADDRESS=0x...
GUILD_PERMISSIONS_ADDRESS=0x...
TASK_COORDINATOR_ADDRESS=0x...

# ── Venice AI ─────────────────────────────────────────────────────────────────
VENICE_API_KEY=your_venice_api_key
VENICE_BASE_URL=https://api.venice.ai/api/v1

# ── 1Shot Relayer ─────────────────────────────────────────────────────────────
ONESHOT_API_KEY=your_oneshot_api_key
ONESHOT_BASE_URL=https://api.1shot.link/v1

# ── Celo Builders Attribution Tag (ERC-8021) ──────────────────────────────────
# Required for hackathon leaderboard tracking. Get this from Celo Builders registration.
ATTRIBUTION_TAG=celo_xxxxxxxxxxxx

# ── x402 Facilitator (Track 2) ────────────────────────────────────────────────
# Celo's self-hosted facilitator for USDC micropayments
X402_FACILITATOR_URL=https://x402.celo.org

# ── USDC on Celo Mainnet (EIP-3009 compatible) ────────────────────────────────
USDC_ADDRESS=0xcebA9300f2b948710d2653dD7B07f33A8B32118C

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
X402_PORT=3001
