{
  "name": "ai-net-backend",
  "version": "1.0.0",
  "description": "GuildNet coordinator backend — orchestrates AI agents on-chain",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn src/server.ts",
    "runner": "ts-node src/taskRunner.ts --daemon",
    "runner:once": "ts-node src/taskRunner.ts",
    "x402-demo": "ts-node src/x402Demo.ts --daemon",
    "x402-demo:once": "ts-node src/x402Demo.ts",
    "register-agents": "ts-node src/registerAgents.ts",
    "askbots": "ts-node src/askbots.ts --daemon",
    "askbots:once": "ts-node src/askbots.ts",
    "askbots:register": "ts-node src/askbots.ts --register",
    "askbots:profile": "ts-node src/askbots.ts --profile",
    "aigora": "ts-node src/aigora.ts --daemon",
    "aigora:once": "ts-node src/aigora.ts",
    "aigora:register": "ts-node src/aigora.ts --register",
    "aigora:discover": "ts-node src/aigora.ts --discover",
    "erc8004": "ts-node src/registerAgents.ts"
  },
  "dependencies": {
    "@celo/attribution-tags": "^0.3.0",
    "@scure/bip32": "1.4.0",
    "@scure/bip39": "1.3.0",
    "@x402/core": "^2.18.0",
    "@x402/evm": "^2.18.0",
    "@x402/fetch": "^2.18.0",
    "axios": "1.7.2",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-rate-limit": "7.3.1",
    "viem": "^2.17.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.14.9",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.5.3"
  }
}
